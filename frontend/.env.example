# ─────────────────────────────────────────────────────────────
# CubeRanked — Frontend Environment Example
# Copy this to .env and customize for your setup.
# Vite only reads variables prefixed with VITE_.
# ─────────────────────────────────────────────────────────────

# Backend API URL (default: http://<window.location.hostname>:4000/api/v1)
# VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Socket.IO server URL (default: http://<window.location.hostname>:4000/v1)
# VITE_SOCKET_URL=http://127.0.0.1:4000/v1
