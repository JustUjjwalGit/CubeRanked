# ─────────────────────────────────────────────────────────────
# CubeRanked — Frontend Environment Example
# Copy this to .env.local and fill in your values.
# Vite only reads variables prefixed with VITE_.
# ─────────────────────────────────────────────────────────────

# Supabase project configuration (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API URL override.
# Leave empty for same-origin development through Vite proxy: /api/v1
VITE_API_URL=

# Socket.IO server URL override.
# Leave empty for same-origin development through Vite proxy: <current-origin>/v1
VITE_SOCKET_URL=

# Application display name
VITE_APP_NAME=CubeRanked
