# ─────────────────────────────────────────────────────────────
# CubeRanked — Backend Environment Example
# Copy this to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# Server
APP_PORT=4000
APP_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Supabase (required for auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database (PostgreSQL)
DATABASE_URL=
REDIS_URL=

# Auth store (JSON file path, relative to cwd)
AUTH_STORE_PATH=data/auth-store.json

# Frontend origin (CORS — comma-separated list)
FRONTEND_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
FRONTEND_CORS_ALLOW_ANY=false
