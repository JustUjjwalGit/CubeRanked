# ─── Backend ───────────────────────────────────────────
NODE_ENV=development
APP_NAME=CubeRanked
APP_VERSION=0.1.0
APP_PORT=4000
APP_HOST=0.0.0.0
API_PREFIX=/api/v1
SOCKET_PATH=/v1
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_CORS_ALLOW_ANY=true
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_STORE_PATH=data/auth-store.json
LOG_LEVEL=info
DATABASE_URL=postgresql://cuberanked:cuberanked@db:5432/cuberanked?schema=public
REDIS_URL=redis://redis:6379

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ─── Frontend ──────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1
VITE_SOCKET_URL=http://127.0.0.1:4000/v1
